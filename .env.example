# Default provider: local Ollama. No API key or paid subscription needed.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:1.5b
# Used for npm run dev when Ollama runs on your computer.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional Gemini alternative (set LLM_PROVIDER=gemini to enable).
# Do not commit your real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DATABASE_PATH=./data/rl-chat.db
PORT=3000
