# Gemini API key is used by the backend only. Never put it in VITE_*.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Change this if the preview model is unavailable in your account/region.
GEMINI_MODEL=gemini-3-flash-preview
# For local development: ./data/rl-chat.db. Docker/Kubernetes override to /data/rl-chat.db.
DATABASE_PATH=./data/rl-chat.db
PORT=3000
